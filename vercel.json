{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/ping.ts": {
            "maxDuration": 30
        },
        "api/index.ts": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/cleanup-artworks",
            "schedule": "0 3 * * *"
        }
    ]
}